# Site canonical URL for SEO, sitemap, robots and structured data.
SITE_URL=https://shijis.xyz
NEXT_PUBLIC_SITE_URL=https://shijis.xyz

# Search engine ownership verification. You can also keep using files in public/.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Baidu Analytics 32-character site id. Empty means Baidu Analytics is disabled.
BAIDU_TONGJI_ID=

# Google Tag / Google Ads tag id, for example G-XXXX or AW-XXXX. Loaded only after user consent.
GOOGLE_TAG_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=

# Microsoft Advertising UET tag id. Loaded only after user consent.
MICROSOFT_UET_TAG_ID=
NEXT_PUBLIC_MICROSOFT_UET_TAG_ID=

# Visit counter. Default: busuanzi. Set to off to hide it.
VISIT_COUNTER_PROVIDER=busuanzi

# Chapter-end self-operated promotion slot. It is shown only when image and target URLs are both configured.
AD_CHAPTER_END_IMAGE_URL=
AD_CHAPTER_END_TARGET_URL=
AD_CHAPTER_END_ALT=推广内容
AD_CHAPTER_END_SPONSOR=合作推广
